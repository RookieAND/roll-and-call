  "exports": {
    ".": "./src/index.ts",
    "./audit": "./src/modules/audit/index.ts",
    "./audit/model": "./src/modules/audit/model/index.ts",
    "./badges": "./src/modules/badges/index.ts",
    "./badges/model": "./src/modules/badges/model/index.ts",
    "./certifications": "./src/modules/certifications/index.ts",
    "./certifications/model": "./src/modules/certifications/model/index.ts",
    "./games": "./src/modules/games/index.ts",
    "./games/model": "./src/modules/games/model/index.ts",
    "./moderation": "./src/modules/moderation/index.ts",
    "./moderation/model": "./src/modules/moderation/model/index.ts",
    "./notifications": "./src/modules/notifications/index.ts",
    "./notifications/model": "./src/modules/notifications/model/index.ts",
    "./onboarding": "./src/modules/onboarding/index.ts",
    "./onboarding/model": "./src/modules/onboarding/model/index.ts",
    "./profiles": "./src/modules/profiles/index.ts",
    "./profiles/model": "./src/modules/profiles/model/index.ts",
    "./reviews": "./src/modules/reviews/index.ts",
    "./rulebooks": "./src/modules/rulebooks/index.ts",
    "./rulebooks/model": "./src/modules/rulebooks/model/index.ts",
    "./servers": "./src/modules/servers/index.ts",
    "./servers/model": "./src/modules/servers/model/index.ts",
    "./transaction": "./src/modules/transaction/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@roll-and-call/app-kit": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "es-toolkit": "catalog:",
    "postgres": "^3.4.9",
    "server-only": "catalog:"
  },
  "devDependencies": {
    "@roll-and-call/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
