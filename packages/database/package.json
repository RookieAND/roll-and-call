{
  "name": "@roll-and-call/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#db/schema": "./src/schema/index.ts",
    "#db/modules/audit": "./src/modules/audit/index.ts",
    "#db/modules/audit/model": "./src/modules/audit/model/index.ts",
    "#db/modules/badges": "./src/modules/badges/index.ts",
    "#db/modules/badges/model": "./src/modules/badges/model/index.ts",
    "#db/modules/certifications": "./src/modules/certifications/index.ts",
    "#db/modules/certifications/model": "./src/modules/certifications/model/index.ts",
    "#db/modules/games": "./src/modules/games/index.ts",
    "#db/modules/games/model": "./src/modules/games/model/index.ts",
    "#db/modules/moderation": "./src/modules/moderation/index.ts",
    "#db/modules/moderation/model": "./src/modules/moderation/model/index.ts",
    "#db/modules/notifications": "./src/modules/notifications/index.ts",
    "#db/modules/notifications/model": "./src/modules/notifications/model/index.ts",
    "#db/modules/onboarding": "./src/modules/onboarding/index.ts",
    "#db/modules/onboarding/model": "./src/modules/onboarding/model/index.ts",
    "#db/modules/profiles": "./src/modules/profiles/index.ts",
    "#db/modules/profiles/model": "./src/modules/profiles/model/index.ts",
    "#db/modules/reviews": "./src/modules/reviews/index.ts",
    "#db/modules/rulebooks": "./src/modules/rulebooks/index.ts",
    "#db/modules/rulebooks/model": "./src/modules/rulebooks/model/index.ts",
    "#db/modules/servers": "./src/modules/servers/index.ts",
    "#db/modules/servers/model": "./src/modules/servers/model/index.ts",
    "#db/modules/transaction": "./src/modules/transaction/index.ts",
    "#db/*": "./src/*.ts"
