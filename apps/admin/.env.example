NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 사용자 앱과 같은 DB(Supabase 트랜잭션 풀러)
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-region.pooler.supabase.com:6543/postgres

# 늘 소유자로 들어오는 디스코드 id. 운영진 표가 비어 있을 때 첫 소유자를 들이는 입구다. 쉼표로 여러 명.
ADMIN_OWNER_DISCORD_IDS=

# 권한 없음 화면의 [사용자 앱으로]
NEXT_PUBLIC_USER_APP_URL=https://your-app.vercel.app
