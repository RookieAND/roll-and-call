NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Postgres — use the connection pooler (transaction mode) string
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-region.pooler.supabase.com:6543/postgres

# Discord bot token — all messages, recruit-post threads/edits and session channels go through the bot
DISCORD_BOT_TOKEN=your-bot-token
# Recruit channel — new game posts (join/wait/leave go to each post's thread) & 1h reminders
DISCORD_RECRUIT_CHANNEL_ID=your-channel-id
# Closed-recruitment channel — "recruitment complete" posts
DISCORD_CLOSED_CHANNEL_ID=your-channel-id
# Discord server where the bot opens per-session category + channels (needs Manage Channels & Manage Roles)
DISCORD_GUILD_ID=your-guild-id

# Public site origin — links games from Discord embeds (optional; falls back to VERCEL_URL)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Shared secret for the reminder cron — Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=some-long-random-string

# Discord application public key — 슬래시 커맨드 서명 검증
DISCORD_PUBLIC_KEY=
DISCORD_PATCHNOTE_WEBHOOK_URL=your-patchnote-webhook-url
