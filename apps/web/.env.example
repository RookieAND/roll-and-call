NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Postgres — use the connection pooler (transaction mode) string
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-region.pooler.supabase.com:6543/postgres

# Discord channel webhook — recruitment-complete & reminder announcements post here
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# Shared secret for the reminder cron — Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=some-long-random-string
