NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Postgres — use the connection pooler (transaction mode) string
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-region.pooler.supabase.com:6543/postgres

# Discord bot token — all messages, recruit-post threads/edits and session channels go through the bot
DISCORD_BOT_TOKEN=your-bot-token
# 구인·완료·후기 포럼 채널 id는 servers 행에 있다. 이 값은 슬래시 커맨드 등록 스크립트만 읽는다.
DISCORD_GUILD_ID=your-guild-id

# 지금 앱이 보여 줄 서버(servers.slug). /[server] 라우트가 생기기 전까지 쓴다.
DEFAULT_SERVER_SLUG=trpia

# Public site origin — links games from Discord embeds (optional; falls back to VERCEL_URL)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# 운영진 채널 글의 [어드민에서 열기] 링크. 비면 링크 버튼을 붙이지 않는다. 끝 슬래시 없이.
ADMIN_APP_URL=https://admin.example.app

# Discord application public key — 슬래시 커맨드 서명 검증
DISCORD_PUBLIC_KEY=
DISCORD_PATCHNOTE_WEBHOOK_URL=your-patchnote-webhook-url
