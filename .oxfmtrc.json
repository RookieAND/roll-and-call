{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ],
    "newlinesBetween": true
  },
  "ignorePatterns": [
    "apps/web/docs/**",
    "packages/database/drizzle/**",
    "**/vercel.json",
    ".oxlintrc.json",
    ".claude/skills/**",
    "README.md",
    "docs/**"
  ]
}
